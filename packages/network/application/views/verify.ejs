<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Product Authenticity - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .verification-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .verify-card {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
        }
        .verify-header {
            background-color: #198754;
            color: white;
            padding: 30px;
            text-align: center;
        }
        .verify-body {
            padding: 30px;
            background-color: white;
        }
        .verify-footer {
            background-color: #f8f9fa;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #dee2e6;
        }
        .verification-success {
            text-align: center;
            padding: 20px;
            margin-bottom: 20px;
        }
        .verification-icon {
            font-size: 80px;
            margin-bottom: 20px;
            color: #198754;
        }
        .product-image {
            width: 100%;
            max-width: 300px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .product-info {
            margin-bottom: 30px;
        }
        .material-label {
            display: inline-block;
            padding: 6px 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            background-color: #e9ecef;
            border-radius: 50px;
        }
        .sustainable {
            background-color: #d1e7dd;
            color: #0f5132;
        }
        .supply-chain-timeline {
            position: relative;
            padding-left: 20px;
        }
        .supply-chain-timeline::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 3px;
            height: 100%;
            background-color: #6c757d;
            border-radius: 3px;
        }
        .chain-step {
            position: relative;
            padding-left: 20px;
            margin-bottom: 20px;
        }
        .chain-step::before {
            content: '';
            position: absolute;
            left: -10px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #198754;
            border: 3px solid white;
        }
        .chain-step-title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .chain-step-content {
            color: #6c757d;
        }
        .impact-stat {
            text-align: center;
            margin-bottom: 20px;
        }
        .impact-value {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .impact-label {
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="verification-container mt-5">
        <div class="verify-card">
            <div class="verify-header">
                <h1 class="mb-2">Product Verification</h1>
                <p class="mb-0">SustainableFashionChain Authentication</p>
            </div>

            <div class="verify-body">
                <div class="verification-success">
                    <div class="verification-icon">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h2 class="text-success mb-2">Authentic Product</h2>
                    <p class="lead mb-0">This product is verified as authentic on the SustainableFashionChain blockchain.</p>
                </div>

                <div class="row product-info">
                    <div class="col-md-4 text-center">
                        <img src="/images/product-placeholder.jpg" alt="Product Image" class="product-image">
                    </div>
                    <div class="col-md-8">
                        <h3><%= product.type %></h3>
                        <p class="text-muted">Product ID: <%= product.id %></p>

                        <p><strong>Manufacturer:</strong> <%= product.manufacturer %></p>
                        <p><strong>Production Date:</strong> <%= new Date(product.productDate).toLocaleDateString() %></p>

                        <% if (product.nftTokenId) { %>
                            <p>
                                <strong>NFT Token ID:</strong>
                                <a href="https://opensea.io/assets/ethereum/0x123456789/<%= product.nftTokenId %>" target="_blank">
                                    <%= product.nftTokenId %>
                                    <i class="bi bi-box-arrow-up-right ms-1"></i>
                                </a>
                            </p>
                        <% } %>

                        <div class="mt-3">
                            <p><strong>Materials:</strong></p>
                            <% product.materials.forEach(material => { %>
                                <div class="material-label <%= material.sustainable ? 'sustainable' : '' %>">
                                    <%= material.type %> (<%= material.percentage %>%)
                                    <% if (material.sustainable) { %>
                                        <i class="bi bi-leaf ms-1"></i>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <hr>

                <h4 class="mb-4">Sustainability & Impact</h4>
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="impact-stat">
                            <div class="impact-value text-success">45%</div>
                            <div class="impact-label">Carbon Reduction</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="impact-stat">
                            <div class="impact-value text-primary">62%</div>
                            <div class="impact-label">Water Saved</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="impact-stat">
                            <div class="impact-value text-warning">38%</div>
                            <div class="impact-label">Chemical Reduction</div>
                        </div>
                    </div>
                </div>

                <hr>

                <h4 class="mb-4">Supply Chain Journey</h4>
                <div class="supply-chain-timeline">
                    <div class="chain-step">
                        <div class="chain-step-title">Cotton Farming</div>
                        <div class="chain-step-content">
                            Ethically sourced cotton from sustainable farms in India
                        </div>
                    </div>
                    <div class="chain-step">
                        <div class="chain-step-title">Certification</div>
                        <div class="chain-step-content">
                            Verified organic and fair trade certifications
                        </div>
                    </div>
                    <div class="chain-step">
                        <div class="chain-step-title">Processing & Manufacturing</div>
                        <div class="chain-step-content">
                            Eco-friendly manufacturing with reduced water and energy usage
                        </div>
                    </div>
                    <div class="chain-step">
                        <div class="chain-step-title">Quality Control</div>
                        <div class="chain-step-content">
                            Rigorous quality checks and blockchain verification
                        </div>
                    </div>
                    <div class="chain-step">
                        <div class="chain-step-title">Distribution</div>
                        <div class="chain-step-content">
                            Carbon-neutral shipping and distribution
                        </div>
                    </div>
                </div>
            </div>

            <div class="verify-footer">
                <a href="/" class="btn btn-outline-success me-2">
                    <i class="bi bi-house me-1"></i>Home
                </a>
                <a href="/products/<%= product.id %>" class="btn btn-success">
                    <i class="bi bi-info-circle me-1"></i>Detailed Product Information
                </a>
            </div>
        </div>

        <div class="text-center mt-4 mb-5">
            <img src="/images/blockchain-verified.png" alt="Blockchain Verified" height="60">
            <p class="text-muted mt-3">
                <small>This verification page provides proof of authenticity for this product on the blockchain. The information displayed has been cryptographically verified and cannot be tampered with.</small>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>