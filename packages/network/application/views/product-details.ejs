<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <style>
        .product-detail-card {
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .product-detail-card .card-header {
            border-radius: 10px 10px 0 0;
            font-weight: bold;
        }
        .detail-badge {
            font-size: 0.85rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .badge-section {
            margin-bottom: 1rem;
        }
        .material-box {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }
        .material-percent {
            width: 100%;
            height: 10px;
            background-color: #e9ecef;
            border-radius: 5px;
            overflow: hidden;
            margin-top: 5px;
        }
        .material-percent-fill {
            height: 100%;
            background-color: #198754;
        }
        .qr-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 20px;
        }
        .qr-card {
            width: 100%;
            max-width: 300px;
            margin-bottom: 1rem;
        }
        #qrcode {
            padding: 15px;
            background-color: white;
        }
        .nft-display {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            background-color: #f8f9fa;
            margin-bottom: 20px;
        }
        .nft-title {
            font-size: 1.25rem;
            font-weight: bold;
            margin-bottom: 10px;
        }
        .nft-image {
            width: 100%;
            height: auto;
            border-radius: 10px;
            margin-bottom: 15px;
        }
        .nft-meta {
            font-size: 0.85rem;
            color: #6c757d;
        }
        .nft-attribute {
            background-color: #e9ecef;
            border-radius: 5px;
            padding: 8px 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            display: inline-block;
        }
        .nft-attribute span {
            font-weight: bold;
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-tag me-2"></i>Product Details</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/products">Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%= product.id %></li>
                </ol>
            </nav>
        </div>

        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card product-detail-card">
                    <div class="card-header bg-dark text-white">
                        <h4>Product Information</h4>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Product ID: <%= product.id %></h5>
                        <div class="badge-section">
                            <span class="badge bg-info detail-badge"><%= product.type %></span>
                            <% if (product.nftTokenId) { %>
                                <span class="badge bg-warning text-dark detail-badge">NFT Minted</span>
                            <% } %>
                            <%
                                let sustainableCount = 0;
                                product.materials.forEach(material => {
                                    if (material.sustainable) sustainableCount++;
                                });
                                const sustainablePercent = Math.round((sustainableCount / product.materials.length) * 100);
                            %>
                            <span class="badge bg-success detail-badge"><%= sustainablePercent %>% Sustainable</span>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p><strong>Manufacturer:</strong> <%= product.manufacturer %></p>
                                <p><strong>Production Date:</strong> <%= new Date(product.productDate).toLocaleDateString() %></p>
                            </div>
                            <div class="col-md-6">
                                <% if (product.nftTokenId) { %>
                                    <p><strong>NFT Token ID:</strong> <%= product.nftTokenId %></p>
                                    <p>
                                        <a href="https://opensea.io/assets/ethereum/0x123456789/<%= product.nftTokenId %>"
                                           target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>View on OpenSea
                                        </a>
                                    </p>
                                <% } else { %>
                                    <p><strong>NFT Status:</strong> Not Minted</p>
                                <% } %>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3">Materials Composition</h5>
                        <div class="row">
                            <% product.materials.forEach(material => { %>
                                <div class="col-md-6">
                                    <div class="material-box">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <strong><%= material.type %></strong>
                                                <% if (material.sustainable) { %>
                                                    <span class="badge bg-success ms-2">Sustainable</span>
                                                <% } %>
                                            </div>
                                            <div><%= material.percentage %>%</div>
                                        </div>
                                        <div class="material-percent">
                                            <div class="material-percent-fill" style="width: <%= material.percentage %>%;"></div>
                                        </div>
                                        <small class="text-muted mt-2 d-block">Batch ID:
                                            <a href="/batches/<%= material.batchId %>"><%= material.batchId %></a>
                                        </small>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <div class="card product-detail-card">
                    <div class="card-header bg-info text-white">
                        <h4>Product History</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Event Type</th>
                                        <th>Date & Time</th>
                                        <th>Actor</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% product.history.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp)).forEach(event => { %>
                                        <tr>
                                            <td><%= event.type %></td>
                                            <td><%= new Date(event.timestamp).toLocaleString() %></td>
                                            <td><%= event.actor %></td>
                                            <td><%= event.details %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="qr-container">
                    <div class="card qr-card">
                        <div class="card-header bg-dark text-white text-center">
                            <h5 class="mb-0">Product Verification QR</h5>
                        </div>
                        <div class="card-body p-0">
                            <div id="qrcode" class="text-center"></div>
                        </div>
                        <div class="card-footer text-center">
                            <small class="text-muted">Scan to verify product authenticity</small>
                        </div>
                    </div>
                    <button class="btn btn-outline-dark" id="downloadQR">
                        <i class="bi bi-download me-2"></i>Download QR Code
                    </button>
                </div>

                <% if (product.nftTokenId) { %>
                    <div class="nft-display">
                        <div class="nft-title">NFT Digital Twin</div>
                        <img src="/images/nft-placeholder.jpg" alt="NFT Digital Twin" class="nft-image">
                        <div class="nft-meta mb-3">
                            Token ID: <%= product.nftTokenId %><br>
                            Contract: 0x123456789...<br>
                            Blockchain: Ethereum
                        </div>
                        <div>
                            <div class="nft-attribute">
                                <span>Type:</span> <%= product.type %>
                            </div>
                            <div class="nft-attribute">
                                <span>Manufacturer:</span> <%= product.manufacturer %>
                            </div>
                            <% if (sustainablePercent >= 80) { %>
                                <div class="nft-attribute">
                                    <span>Certification:</span> Highly Sustainable
                                </div>
                            <% } else if (sustainablePercent >= 50) { %>
                                <div class="nft-attribute">
                                    <span>Certification:</span> Sustainable
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } else { %>
                    <div class="card product-detail-card">
                        <div class="card-header bg-warning text-dark">
                            <h4>Mint NFT</h4>
                        </div>
                        <div class="card-body">
                            <p>This product has not been minted as an NFT yet. Minting an NFT creates a digital twin on the Ethereum blockchain.</p>
                            <button class="btn btn-warning w-100" id="mintNFT">
                                <i class="bi bi-coin me-2"></i>Mint NFT for This Product
                            </button>
                        </div>
                    </div>
                <% } %>

                <div class="card product-detail-card mt-4">
                    <div class="card-header bg-success text-white">
                        <h4>Sustainability Metrics</h4>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Carbon Footprint:</span>
                            <span class="badge bg-success">45% Reduction</span>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 45%"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Water Usage:</span>
                            <span class="badge bg-info">62% Reduction</span>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: 62%"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Chemical Usage:</span>
                            <span class="badge bg-warning text-dark">38% Reduction</span>
                        </div>
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 38%"></div>
                        </div>

                        <p class="mt-3 mb-0 text-muted">
                            <small>Compared to industry averages for similar products</small>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12 d-flex justify-content-between">
                <a href="/products" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to All Products
                </a>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Generate QR code
            const productVerificationUrl = window.location.origin + '/verify/' + '<%= product.id %>';
            const qrcode = new QRCode(document.getElementById('qrcode'), {
                text: productVerificationUrl,
                width: 256,
                height: 256,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.H
            });

            // Download QR code
            document.getElementById('downloadQR').addEventListener('click', function() {
                // Get the QR code image
                const img = document.querySelector('#qrcode img');

                // Create a temporary link
                const a = document.createElement('a');
                a.href = img.src;
                a.download = 'product-<%= product.id %>-qr.png';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });

            <% if (!product.nftTokenId) { %>
            // Mint NFT
            document.getElementById('mintNFT').addEventListener('click', function() {
                mintProductNFT();
            });
            <% } %>
        });

        async function mintProductNFT() {
            try {
                const response = await fetch('/api/mint-nft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        productId: '<%= product.id %>'
                    })
                });

                const result = await response.json();

                if (response.ok) {
                    alert('NFT minting request submitted successfully! The process may take a few minutes to complete.');
                    // In a real application, we might poll for updates or use WebSockets
                    // For now, just reload after a delay
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error minting NFT:', error);
                alert('Failed to mint NFT. See console for details.');
            }
        }
    </script>
</body>
</html>