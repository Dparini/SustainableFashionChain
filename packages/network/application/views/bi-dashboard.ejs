            </div>
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="metric-icon text-warning">
                        <i class="bi bi-coin"></i>
                    </div>
                    <div class="metric-value" id="tokenizedBatches">65</div>
                    <div class="metric-label">Tokenized Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="metric-icon text-danger">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <div class="metric-value" id="totalValue">$147,520</div>
                    <div class="metric-label">Total Token Value</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- Supply Chain Activity -->
            <div class="col-md-8">
                <div class="dashboard-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Supply Chain Activity</span>
                        <div class="btn-group" role="group" aria-label="Activity timeframe">
                            <button type="button" class="btn btn-sm btn-outline-secondary active" data-period="daily">Daily</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-period="weekly">Weekly</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-period="monthly">Monthly</button>
