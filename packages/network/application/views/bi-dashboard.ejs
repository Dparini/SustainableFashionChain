                                    <tr>
                                        <td>Eco Yoga Pants</td>
                                        <td>YogaGreen</td>
                                        <td>85%</td>
                                        <td>100%</td>
                                    </tr>
                                    <tr>
                                        <td>Sustainable Hoodie</td>
                                        <td>EcoFashion</td>
                                        <td>84%</td>
                                        <td>100%</td>
                                    </tr>
                                    <tr>
                                        <td>Organic Dress</td>
                                        <td>FairFashion</td>
