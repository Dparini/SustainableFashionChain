                    <div class="card-header">
                        <span>Certification Distribution</span>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="certificationChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- Sustainability Metrics -->
            <div class="col-md-6">
                <div class="dashboard-card">
                    <div class="card-header">
                        <span>Sustainability Metrics</span>
                    </div>
                    <div class="card-body">
