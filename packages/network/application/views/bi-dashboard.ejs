        // Refresh all charts
        function refreshAllCharts() {
            // In a real application, this would fetch new data from the API
            // based on the selected date range and filters

            // For this demo, we'll just show a loading indicator
            document.getElementById('refreshData').innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Refreshing...';

            // Simulate loading delay
            setTimeout(() => {
                // Update chart data (with mock data)
                updateMockData();

                // Reset refresh button
                document.getElementById('refreshData').innerHTML = '<i class="bi bi-arrow-clockwise"></i> Refresh';

                // Show success message
                alert('Data refreshed successfully!');
            }, 1500);
        }

        // Update mock data
        function updateMockData() {
            // In a real application, this would update charts with actual data
            // based on API responses

            // For this demo, we'll just make small random changes to the charts

            // Update metrics
            document.getElementById('totalBatches').textContent = Math.floor(Math.random() * 20) + 120;
            document.getElementById('totalProducts').textContent = Math.floor(Math.random() * 10) + 35;
            document.getElementById('tokenizedBatches').textContent = Math.floor(Math.random() * 15) + 60;

            // Update value with random fluctuation
            const baseValue = 147520;
            const fluctuation = Math.floor(Math.random() * 10000) - 5000;
            document.getElementById('totalValue').textContent = '$' + (baseValue + fluctuation).toLocaleString();

            // Update activity chart with slight variations
            window.activityChart.data.datasets.forEach(dataset => {
                dataset.data = dataset.data.map(value => {
                    const change = Math.floor(Math.random() * 5) - 2;
                    return Math.max(0, value + change);
                });
            });
            window.activityChart.update();

            // Update certification chart with slight variations
            window.certificationChart.data.datasets[0].data = window.certificationChart.data.datasets[0].data.map(value => {
                const change = Math.floor(Math.random() * 3) - 1;
                return Math.max(0, value + change);
            });
            window.certificationChart.update();

            // Update tokenization chart with upward trend
            window.tokenizationChart.data.datasets.forEach(dataset => {
                dataset.data = dataset.data.map(value => {
                    const increase = Math.floor(Math.random() * (value * 0.1));
                    return value + increase;
                });
            });
            window.tokenizationChart.update();
        }

