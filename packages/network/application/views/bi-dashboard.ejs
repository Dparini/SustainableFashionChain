            </div>

            <!-- Tokenization Trends -->
            <div class="col-md-6">
                <div class="dashboard-card">
                    <div class="card-header">
                        <span>Tokenization Trends</span>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="tokenizationChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- Supply Chain Map -->
            <div class="col-md-8">
                <div class="dashboard-card">
                    <div class="card-header">
                        <span>Global Supply Chain Map</span>
                    </div>
                    <div class="card-body">
                        <div class="supply-chain-map" id="supplyChainMap">
                            <!-- Map will be rendered here using D3.js -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Supply Chain Risk Assessment -->
            <div class="col-md-4">
                <div class="dashboard-card">
                    <div class="card-header">
                        <span>Supply Chain Risk Assessment</span>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <div class="d-flex justify-content-between">
                                <span>Environmental Compliance</span>
