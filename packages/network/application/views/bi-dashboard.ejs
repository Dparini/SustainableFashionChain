                <div class="dashboard-card">
                    <div class="card-header">
                        <span>Upcoming Certification Expirations</span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Batch ID</th>
                                        <th>Certification</th>
