    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize charts
            initActivityChart();
            initCertificationChart();
            initSustainabilityChart();
            initTokenizationChart();

            // Initialize supply chain map
            initSupplyChainMap();

            // Handle sidebar navigation
            const sidebarLinks = document.querySelectorAll('.sidebar-link');
            sidebarLinks.forEach(link => {
                link.addEventListener('click', function() {
                    sidebarLinks.forEach(l => l.classList.remove('active'));
                    this.classList.add('active');
                });
            });

            // Handle activity chart period buttons
            const periodButtons = document.querySelectorAll('[data-period]');
            periodButtons.forEach(button => {
                button.addEventListener('click', function() {
                    periodButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    updateActivityChart(this.dataset.period);
                });
            });

            // Handle date range change
            document.getElementById('dateRange').addEventListener('change', function() {
                refreshAllCharts();
            });

            // Handle refresh button
            document.getElementById('refreshData').addEventListener('click', function() {
                refreshAllCharts();
            });

            // Handle filter application
            document.getElementById('applyFilters').addEventListener('click', function() {
                refreshAllCharts();
            });
        });

        // Initialize Supply Chain Activity Chart
        function initActivityChart() {
            const ctx = document.getElementById('activityChart').getContext('2d');
            window.activityChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['May 1', 'May 5', 'May 10', 'May 15', 'May 20', 'May 25', 'May 30'],
                    datasets: [
                        {
                            label: 'Batch Registrations',
                            data: [5, 8, 12, 7, 10, 15, 9],
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Certifications',
                            data: [3, 5, 8, 4, 7, 10, 6],
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Tokenizations',
                            data: [1, 3, 5, 2, 4, 7, 3],
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            }
                        }
                    }
                }
            });
        }

        // Update Activity Chart based on period
        function updateActivityChart(period) {
            let labels, batchData, certData, tokenData;

            switch(period) {
                case 'daily':
                    labels = ['May 1', 'May 5', 'May 10', 'May 15', 'May 20', 'May 25', 'May 30'];
                    batchData = [5, 8, 12, 7, 10, 15, 9];
                    certData = [3, 5, 8, 4, 7, 10, 6];
                    tokenData = [1, 3, 5, 2, 4, 7, 3];
                    break;
                case 'weekly':
                    labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
                    batchData = [30, 42, 35, 48];
                    certData = [22, 28, 25, 32];
                    tokenData = [15, 18, 14, 22];
                    break;
                case 'monthly':
                    labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                    batchData = [120, 145, 132, 150, 165, 152];
                    certData = [85, 92, 78, 105, 112, 98];
                    tokenData = [45, 58, 52, 62, 70, 65];
                    break;
                default:
                    return;
            }

            window.activityChart.data.labels = labels;
            window.activityChart.data.datasets[0].data = batchData;
            window.activityChart.data.datasets[1].data = certData;
