<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .error-container {
            padding: 60px 0;
        }
        .error-code {
            font-size: 120px;
            font-weight: bold;
            color: #dc3545;
            line-height: 1;
        }
        .error-message {
            font-size: 24px;
            margin-bottom: 20px;
        }
        .error-details {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .error-illustration {
            max-width: 100%;
            height: auto;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container error-container">
        <div class="row align-items-center">
            <div class="col-md-6 text-center mb-4 mb-md-0">
                <div class="error-code">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h1 class="error-message mb-4">Oops! Something went wrong</h1>
                <p class="lead"><%= message %></p>
                <div class="mt-4">
                    <a href="/" class="btn btn-success me-2">
                        <i class="bi bi-house-fill me-2"></i>Go to Homepage
                    </a>
                    <button class="btn btn-outline-secondary" onclick="history.back()">
                        <i class="bi bi-arrow-left me-2"></i>Go Back
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <img src="/images/error-illustration.svg" alt="Error Illustration" class="error-illustration"
                     onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%%22 height=%22250%22 viewBox=%220 0 600 400%22><rect width=%22600%22 height=%22400%22 fill=%22%23f8f9fa%22></rect><path d=%22M300,150 L350,250 L250,250 Z%22 fill=%22%23dc3545%22></path><circle cx=%22300%22 cy=%22120%22 r=%2225%22 fill=%22%23dc3545%22></circle><text x=%22300%22 y=%22320%22 font-family=%22Arial%22 font-size=%2224%22 text-anchor=%22middle%22 fill=%22%23212529%22>Error Occurred</text></svg>'">
            </div>
        </div>

        <% if (error && process.env.NODE_ENV !== 'production') { %>
            <div class="error-details">
                <h3>Error Details</h3>
                <p>This information is only shown in development mode.</p>
                <pre class="mt-3 p-3 bg-dark text-light rounded"><%= error.stack || error %></pre>
            </div>
        <% } %>

        <div class="alert alert-info">
            <h4 class="alert-heading">Need help?</h4>
            <p>If this issue persists, please try the following:</p>
            <ul>
                <li>Check if the Hyperledger Fabric network is running properly</li>
                <li>Verify that your wallet contains valid identities</li>
                <li>Ensure that the requested resource exists and is accessible</li>
                <li>Contact the system administrator if you continue to experience issues</li>
            </ul>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>