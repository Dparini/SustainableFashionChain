<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SustainableFashionChain Analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.7.1/dist/chart.min.js"></script>
    <style>
        .logo {
            max-height: 60px;
        }
        .dashboard-card {
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .dashboard-card .card-header {
            border-radius: 10px 10px 0 0;
            font-weight: bold;
        }
        .metric-box {
            text-align: center;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .metric-box .value {
            font-size: 24px;
            font-weight: bold;
            margin: 10px 0;
        }
        .metric-box .label {
            font-size: 14px;
            color: #6c757d;
        }
        .metric-box .icon {
            font-size: 30px;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col-md-12 text-center">
                <h1 class="display-4">Supply Chain Analytics</h1>
                <p class="lead">Insights and metrics from your sustainable fashion supply chain</p>
            </div>
        </div>

        <!-- Key Metrics -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="icon text-success">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="value" id="totalBatches">--</div>
                    <div class="label">Total Cotton Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="icon text-primary">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="value" id="certifiedBatches">--</div>
                    <div class="label">Certified Organic</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="icon text-warning">
                        <i class="bi bi-coin"></i>
                    </div>
                    <div class="value" id="tokenizedBatches">--</div>
                    <div class="label">Tokenized Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="metric-box">
                    <div class="icon text-danger">
                        <i class="bi bi-tags"></i>
                    </div>
                    <div class="value" id="totalProducts">--</div>
                    <div class="label">Total Products</div>
                </div>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card dashboard-card">
                    <div class="card-header bg-success text-white">
                        Cotton Batches by Status
                    </div>
                    <div class="card-body">
                        <canvas id="batchStatusChart" height="250"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card dashboard-card">
                    <div class="card-header bg-primary text-white">
                        Cotton Production by Month
                    </div>
                    <div class="card-body">
                        <canvas id="cottonProductionChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row 2 -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card dashboard-card">
                    <div class="card-header bg-info text-white">
                        Supply Chain Activity Timeline
                    </div>
                    <div class="card-body">
                        <canvas id="activityTimelineChart" height="250"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card dashboard-card">
                    <div class="card-header bg-warning text-white">
                        Certifications Distribution
                    </div>
                    <div class="card-body">
                        <canvas id="certificationsPieChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row 3 -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card dashboard-card">
                    <div class="card-header bg-danger text-white">
                        Circular Economy Actions
                    </div>
                    <div class="card-body">
                        <canvas id="circularActionsChart" height="250"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card dashboard-card">
                    <div class="card-header bg-dark text-white">
                        Tokenization vs Products
                    </div>
                    <div class="card-body">
                        <canvas id="tokenizationProductsChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Supply Chain Map -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card dashboard-card">
                    <div class="card-header bg-success text-white">
                        Global Supply Chain Map
                    </div>
                    <div class="card-body">
                        <div id="supplyChainMap" style="height: 400px;">
                            <p class="text-center">Supply chain map visualization would be rendered here with a mapping library like Leaflet.js</p>
                            <p class="text-center">For this prototype, we're showing a placeholder. In production, this would show actual farm and facility locations.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Carbon Footprint Analysis -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card dashboard-card">
                    <div class="card-header bg-primary text-white">
                        Carbon Footprint Analysis
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <canvas id="carbonFootprintChart" height="250"></canvas>
                            </div>
                            <div class="col-md-4">
                                <div class="card mt-3">
                                    <div class="card-body">
                                        <h5 class="card-title">Sustainability Impact</h5>
                                        <p>Total CO2 Reduction: <span class="fw-bold text-success" id="totalCO2Reduction">--</span></p>
                                        <p>Water Saved: <span class="fw-bold text-primary" id="waterSaved">--</span></p>
                                        <p>Land Use Efficiency: <span class="fw-bold text-warning" id="landEfficiency">--</span></p>
                                        <p>Circular Economy Contribution: <span class="fw-bold text-danger" id="circularContribution">--</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Load data for the dashboard
            fetchDashboardData();
        });

        async function fetchDashboardData() {
            try {
                // In a real application, this would fetch data from APIs
                // For demo purposes, we'll use mock data

                // Update key metrics
                document.getElementById('totalBatches').textContent = '124';
                document.getElementById('certifiedBatches').textContent = '87';
                document.getElementById('tokenizedBatches').textContent = '65';
                document.getElementById('totalProducts').textContent = '38';

                // Initialize charts with mock data
                initBatchStatusChart();
                initCottonProductionChart();
                initActivityTimelineChart();
                initCertificationsPieChart();
                initCircularActionsChart();
                initTokenizationProductsChart();
                initCarbonFootprintChart();

                // Update sustainability metrics
                document.getElementById('totalCO2Reduction').textContent = '48.2 tonnes';
                document.getElementById('waterSaved').textContent = '12.4 million liters';
                document.getElementById('landEfficiency').textContent = '+38%';
                document.getElementById('circularContribution').textContent = '42.7%';

            } catch (error) {
                console.error('Error fetching dashboard data:', error);
                alert('Failed to load dashboard data. See console for details.');
            }
        }

        function initBatchStatusChart() {
            const ctx = document.getElementById('batchStatusChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Harvested', 'Certified', 'In Transit', 'Stored', 'Processing', 'Tokenized'],
                    datasets: [{
                        label: 'Number of Batches',
                        data: [25, 22, 18, 24, 15, 20],
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.6)',
                            'rgba(54, 162, 235, 0.6)',
                            'rgba(255, 206, 86, 0.6)',
                            'rgba(153, 102, 255, 0.6)',
                            'rgba(255, 159, 64, 0.6)',
                            'rgba(255, 99, 132, 0.6)'
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function initCottonProductionChart() {
            const ctx = document.getElementById('cottonProductionChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [{
                        label: 'Regular Cotton (kg)',
                        data: [1200, 1350, 1450, 1300, 1200, 1100, 1000, 1150, 1250, 1400, 1500, 1600],
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    },
                    {
                        label: 'Organic Cotton (kg)',
                        data: [800, 950, 1050, 1200, 1400, 1500, 1600, 1700, 1750, 1800, 1850, 1900],
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function initActivityTimelineChart() {
            const ctx = document.getElementById('activityTimelineChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7', 'Week 8'],
                    datasets: [{
                        label: 'Batch Registrations',
                        data: [8, 12, 15, 10, 7, 13, 18, 14],
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2
                    },
                    {
                        label: 'Certifications',
                        data: [4, 8, 12, 9, 5, 10, 15, 12],
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 2
                    },
                    {
                        label: 'Tokenizations',
                        data: [2, 5, 8, 7, 4, 7, 12, 10],
                        backgroundColor: 'rgba(255, 159, 64, 0.2)',
                        borderColor: 'rgba(255, 159, 64, 1)',
                        borderWidth: 2
                    },
                    {
                        label: 'Product Creations',
                        data: [0, 2, 4, 6, 3, 5, 9, 8],
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 2
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function initCertificationsPieChart() {
            const ctx = document.getElementById('certificationsPieChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Organic', 'Fair Trade', 'GOTS', 'BCI', 'Other'],
                    datasets: [{
                        data: [35, 25, 15, 18, 7],
                        backgroundColor: [
                            'rgba(75, 192, 192, 0.6)',
                            'rgba(54, 162, 235, 0.6)',
                            'rgba(255, 206, 86, 0.6)',
                            'rgba(153, 102, 255, 0.6)',
                            'rgba(255, 159, 64, 0.6)'
                        ],
                        borderColor: [
                            'rgba(75, 192, 192, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'right'
                        }
                    }
                }
            });
        }

        function initCircularActionsChart() {
            const ctx = document.getElementById('circularActionsChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Recycle', 'Repair', 'Resell', 'Upcycle'],
                    datasets: [{
                        label: 'Number of Actions',
                        data: [28, 42, 35, 15],
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.6)',
                            'rgba(54, 162, 235, 0.6)',
                            'rgba(75, 192, 192, 0.6)',
                            'rgba(255, 159, 64, 0.6)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(255, 159, 64, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function initTokenizationProductsChart() {
            const ctx = document.getElementById('tokenizationProductsChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                    datasets: [{
                        label: 'Tokenized Cotton (kg)',
                        data: [500, 1200, 1800, 2500, 3200, 4000],
                        backgroundColor: 'rgba(255, 206, 86, 0.2)',
                        borderColor: 'rgba(255, 206, 86, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    },
                    {
                        label: 'Products Created',
                        data: [0, 5, 12, 18, 25, 38],
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        function initCarbonFootprintChart() {
            const ctx = document.getElementById('carbonFootprintChart').getContext('2d');
            const chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Production', 'Certification', 'Transport', 'Manufacturing', 'Retail', 'Consumer Use', 'End of Life'],
                    datasets: [{
                        label: 'Traditional Supply Chain (CO2 kg)',
                        data: [42, 15, 38, 25, 12, 35, 18],
                        backgroundColor: 'rgba(255, 99, 132, 0.6)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'Our Sustainable Chain (CO2 kg)',
                        data: [28, 10, 22, 16, 8, 20, 8],
                        backgroundColor: 'rgba(75, 192, 192, 0.6)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>