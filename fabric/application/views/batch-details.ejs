<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cotton Batch Details - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .timeline {
            position: relative;
            padding-left: 4rem;
            margin: 0 0 0 30px;
        }
        .timeline::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background-color: #6c757d;
            border-radius: 1rem;
        }
        .timeline-item {
            position: relative;
            padding-bottom: 2rem;
        }
        .timeline-item:last-child {
            padding-bottom: 0;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -32px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 4px solid #6c757d;
            background-color: white;
        }
        .timeline-item.creation::before {
            background-color: #198754;
            border-color: #198754;
        }
        .timeline-item.certification::before {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .timeline-item.transfer::before {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }
        .timeline-item.tokenization::before {
            background-color: #6f42c1;
            border-color: #6f42c1;
        }
        .event-date {
            font-size: 0.85rem;
            color: #6c757d;
        }
        .batch-detail-card {
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .batch-detail-card .card-header {
            border-radius: 10px 10px 0 0;
            font-weight: bold;
        }
        .detail-badge {
            font-size: 0.85rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .badge-section {
            margin-bottom: 1rem;
        }
        .batch-map {
            height: 300px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .cert-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-box-seam me-2"></i>Cotton Batch Details</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/batches">Cotton Batches</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%= batch.id %></li>
                </ol>
            </nav>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card batch-detail-card">
                    <div class="card-header bg-success text-white">
                        <h4>Batch Information</h4>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Batch ID: <%= batch.id %></h5>
                        <div class="badge-section">
                            <% if (batch.organic) { %>
                                <span class="badge bg-success detail-badge">Organic</span>
                            <% } %>
                            <% if (batch.fairTrade) { %>
                                <span class="badge bg-primary detail-badge">Fair Trade</span>
                            <% } %>
                            <span class="badge bg-secondary detail-badge"><%= batch.status %></span>
                            <% if (batch.tokenizationId) { %>
                                <span class="badge bg-warning text-dark detail-badge">Tokenized</span>
                            <% } %>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p><strong>Farm ID:</strong> <%= batch.farmId %></p>
                                <p><strong>Quantity:</strong> <%= batch.quantity %> kg</p>
                                <p><strong>Harvest Date:</strong> <%= new Date(batch.harvestDate).toLocaleDateString() %></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Current Custody:</strong> <%= batch.currentCustody %></p>
                                <p><strong>Location:</strong> <%= batch.location %></p>
                                <% if (batch.tokenizationId) { %>
                                    <p><strong>Ethereum Tx:</strong>
                                        <a href="https://etherscan.io/tx/<%= batch.tokenizationId %>" target="_blank" class="text-truncate d-inline-block" style="max-width: 150px;"><%= batch.tokenizationId %></a>
                                    </p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card batch-detail-card">
                    <div class="card-header bg-primary text-white">
                        <h4>Certifications</h4>
                    </div>
                    <div class="card-body">
                        <% if (certifications && certifications.length > 0) { %>
                            <div class="row">
                                <% certifications.forEach(cert => { %>
                                    <div class="col-md-6 text-center mb-4">
                                        <div class="cert-icon text-<%= cert.type === 'Organic' ? 'success' : (cert.type === 'Fair Trade' ? 'primary' : 'warning') %>">
                                            <i class="bi bi-<%= cert.type === 'Organic' ? 'flower1' : (cert.type === 'Fair Trade' ? 'people' : 'patch-check') %>"></i>
                                        </div>
                                        <h5><%= cert.type %></h5>
                                        <p class="mb-1">Issuer: <%= cert.issuerId %></p>
                                        <p class="mb-1">Issue Date: <%= new Date(cert.issueDate).toLocaleDateString() %></p>
                                        <p class="mb-0">Valid Until: <%= new Date(cert.expirationDate).toLocaleDateString() %></p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info">
                                No certifications found for this batch.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="batch-map mb-4 bg-light d-flex align-items-center justify-content-center">
                    <p class="text-muted">Interactive map would be displayed here</p>
                </div>

                <div class="card batch-detail-card">
                    <div class="card-header bg-secondary text-white">
                        <h4>Batch History Timeline</h4>
                    </div>
                    <div class="card-body">
                        <div class="timeline">
                            <% batch.history.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp)).forEach(event => { %>
                                <%
                                    let eventClass = '';
                                    if (event.type === 'Creation') eventClass = 'creation';
                                    else if (event.type === 'CertificationAdded') eventClass = 'certification';
                                    else if (event.type === 'CustodyTransfer') eventClass = 'transfer';
                                    else if (event.type === 'TokenizationRequested' || event.type === 'TokenizationCompleted') eventClass = 'tokenization';
                                %>
                                <div class="timeline-item <%= eventClass %>">
                                    <div class="mb-1">
                                        <span class="fw-bold"><%= event.type %></span>
                                        <span class="event-date ms-2"><%= new Date(event.timestamp).toLocaleString() %></span>
                                    </div>
                                    <div class="mb-1">
                                        Actor: <%= event.actor %>
                                    </div>
                                    <div>
                                        <%= event.details %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card batch-detail-card">
                    <div class="card-header bg-info text-white">
                        <h4>Products Created from this Batch</h4>
                    </div>
                    <div class="card-body">
                        <% if (products && products.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Product ID</th>
                                            <th>Type</th>
                                            <th>Manufacturer</th>
                                            <th>Production Date</th>
                                            <th>NFT Token ID</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% products.forEach(product => { %>
                                            <tr>
                                                <td><%= product.id %></td>
                                                <td><%= product.type %></td>
                                                <td><%= product.manufacturer %></td>
                                                <td><%= new Date(product.productDate).toLocaleDateString() %></td>
                                                <td>
                                                    <% if (product.nftTokenId) { %>
                                                        <span class="badge bg-purple"><%= product.nftTokenId %></span>
                                                    <% } else { %>
                                                        <span class="badge bg-secondary">Not Minted</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a href="/products/<%= product.id %>" class="btn btn-sm btn-primary">View</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info">
                                No products have been created from this batch yet.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12 d-flex justify-content-between">
                <a href="/batches" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to All Batches
                </a>
                <div>
                    <% if (batch.status === 'Stored' && !batch.tokenizationId) { %>
                        <button class="btn btn-warning me-2" data-bs-toggle="modal" data-bs-target="#tokenizeModal">
                            <i class="bi bi-coin me-2"></i>Request Tokenization
                        </button>
                    <% } %>
                    <% if (batch.status !== 'Harvested') { %>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#transferModal">
                            <i class="bi bi-arrow-left-right me-2"></i>Transfer Custody
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Tokenize Modal -->
    <div class="modal fade" id="tokenizeModal" tabindex="-1" aria-labelledby="tokenizeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tokenizeModalLabel">Request Tokenization</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="tokenizeForm">
                        <div class="mb-3">
                            <label for="requestId" class="form-label">Request ID</label>
                            <input type="text" class="form-control" id="requestId" value="req_<%= Date.now() %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="warehouseId" class="form-label">Warehouse ID</label>
                            <input type="text" class="form-control" id="warehouseId" required>
                        </div>
                        <div class="mb-3">
                            <label for="tokenQuantity" class="form-label">Quantity to Tokenize (kg)</label>
                            <input type="number" class="form-control" id="tokenQuantity" max="<%= batch.quantity %>" value="<%= batch.quantity %>" required>
                            <small class="text-muted">Maximum available: <%= batch.quantity %> kg</small>
                        </div>
                        <input type="hidden" id="batchId" value="<%= batch.id %>">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="tokenizeSubmit">Request Tokenization</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Transfer Modal -->
    <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="transferModalLabel">Transfer Custody</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="transferForm">
                        <div class="mb-3">
                            <label for="fromCustody" class="form-label">From</label>
                            <input type="text" class="form-control" id="fromCustody" value="<%= batch.currentCustody %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="toCustody" class="form-label">To</label>
                            <input type="text" class="form-control" id="toCustody" required>
                        </div>
                        <div class="mb-3">
                            <label for="transportId" class="form-label">Transport ID</label>
                            <input type="text" class="form-control" id="transportId" value="trans_<%= Date.now() %>" required>
                        </div>
                        <input type="hidden" id="transferBatchId" value="<%= batch.id %>">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="transferSubmit">Transfer Custody</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tokenize form submission
            document.getElementById('tokenizeSubmit').addEventListener('click', function() {
                requestTokenization();
            });

            // Transfer form submission
            document.getElementById('transferSubmit').addEventListener('click', function() {
                transferCustody();
            });
        });

        async function requestTokenization() {
            try {
                const data = {
                    requestID: document.getElementById('requestId').value,
                    batchID: document.getElementById('batchId').value,
                    quantity: parseFloat(document.getElementById('tokenQuantity').value),
                    warehouseID: document.getElementById('warehouseId').value
                };

                const response = await fetch('/api/tokenize', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Tokenization requested successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error requesting tokenization:', error);
                alert('Failed to request tokenization. See console for details.');
            }
        }

        async function transferCustody() {
            try {
                const data = {
                    batchID: document.getElementById('transferBatchId').value,
                    fromCustody: document.getElementById('fromCustody').value,
                    toCustody: document.getElementById('toCustody').value,
                    transportID: document.getElementById('transportId').value
                };

                const response = await fetch('/api/transfer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Custody transferred successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error transferring custody:', error);
                alert('Failed to transfer custody. See console for details.');
            }
        }
    </script>
</body>
</html>