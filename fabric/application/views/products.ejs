<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .product-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }
        .product-image {
            height: 200px;
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #adb5bd;
        }
        .card-header {
            font-weight: bold;
        }
        .filters {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .detail-badge {
            font-size: 0.8rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .product-icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
            color: #6610f2;
        }
        .summary-box {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            text-align: center;
        }
        .summary-value {
            font-size: 2rem;
            font-weight: bold;
            margin: 10px 0;
        }
        .summary-label {
            color: #6c757d;
        }
        .sustainability-indicator {
            display: inline-block;
            width: 100%;
            height: 8px;
            background-color: #dee2e6;
            border-radius: 4px;
            margin-top: 5px;
            overflow: hidden;
        }
        .sustainability-fill {
            height: 100%;
            background-color: #198754;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-bag me-2"></i>Products</h1>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newProductModal">
                <i class="bi bi-plus-circle me-2"></i>Create New Product
            </button>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="product-icon">
                        <i class="bi bi-bag"></i>
                    </div>
                    <div class="summary-value"><%= products.length %></div>
                    <div class="summary-label">Total Products</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="product-icon text-warning">
                        <i class="bi bi-award"></i>
                    </div>
                    <div class="summary-value">
                        <%=
                            products.filter(p => {
                                // Count products with at least 70% sustainable materials
                                let sustainableCount = 0;
                                let totalCount = p.materials.length;

                                p.materials.forEach(m => {
                                    if (m.sustainable) sustainableCount++;
                                });

                                return (sustainableCount / totalCount) >= 0.7;
                            }).length
                        %>
                    </div>
                    <div class="summary-label">Highly Sustainable</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="product-icon text-primary">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="summary-value">
                        <%=
                            // Calculate total batches used
                            products.reduce((acc, product) => acc + product.batchIDs.length, 0)
                        %>
                    </div>
                    <div class="summary-label">Batches Used</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="product-icon text-info">
                        <i class="bi bi-layers"></i>
                    </div>
                    <div class="summary-value">
                        <%= products.filter(p => p.nftTokenId).length %>
                    </div>
                    <div class="summary-label">NFTs Minted</div>
                </div>
            </div>
        </div>

        <div class="filters mb-4">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="typeFilter" class="form-label">Product Type</label>
                    <select class="form-select" id="typeFilter">
                        <option value="">All Types</option>
                        <%
                            // Get unique product types
                            const types = [...new Set(products.map(p => p.type))];
                            types.forEach(type => {
                        %>
                            <option value="<%= type %>"><%= type %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="manufacturerFilter" class="form-label">Manufacturer</label>
                    <select class="form-select" id="manufacturerFilter">
                        <option value="">All Manufacturers</option>
                        <%
                            // Get unique manufacturers
                            const manufacturers = [...new Set(products.map(p => p.manufacturer))];
                            manufacturers.forEach(manufacturer => {
                        %>
                            <option value="<%= manufacturer %>"><%= manufacturer %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="searchFilter" class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchFilter" placeholder="Search by ID, type...">
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" id="applyFilters">
                        <i class="bi bi-funnel me-2"></i>Apply Filters
                    </button>
                </div>
            </div>
        </div>

        <div class="row" id="productsContainer">
            <% products.forEach(product => {
                // Calculate sustainability percentage
                let sustainablePercent = 0;
                if (product.materials && product.materials.length > 0) {
                    const sustainableMaterials = product.materials.filter(m => m.sustainable);
                    sustainablePercent = Math.round((sustainableMaterials.length / product.materials.length) * 100);
                }
            %>
                <div class="col-md-4 product-item"
                     data-type="<%= product.type %>"
                     data-manufacturer="<%= product.manufacturer %>"
                     data-nft="<%= product.nftTokenId ? 'true' : 'false' %>">
                    <div class="card product-card">
                        <div class="product-image">
                            <i class="bi bi-bag"></i>
                        </div>
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div><%= product.type %></div>
                            <div>
                                <% if (sustainablePercent >= 70) { %>
                                    <span class="badge bg-success detail-badge">Highly Sustainable</span>
                                <% } else if (sustainablePercent >= 40) { %>
                                    <span class="badge bg-info detail-badge">Sustainable</span>
                                <% } %>
                                <% if (product.nftTokenId) { %>
                                    <span class="badge bg-warning text-dark detail-badge">NFT</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Product ID: <%= product.id %></h5>
                            <p><strong>Manufacturer:</strong> <%= product.manufacturer %></p>
                            <p><strong>Production Date:</strong> <%= new Date(product.productDate).toLocaleDateString() %></p>
                            <p><strong>Materials:</strong> <%= product.materials.length %> components</p>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span>Sustainability:</span>
                                <span><%= sustainablePercent %>%</span>
                            </div>
                            <div class="sustainability-indicator">
                                <div class="sustainability-fill" style="width: <%= sustainablePercent %>%;"></div>
                            </div>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a href="/products/<%= product.id %>" class="btn btn-outline-primary">
                                <i class="bi bi-info-circle me-2"></i>View Details
                            </a>

                            <% if (!product.nftTokenId) { %>
                                <button class="btn btn-outline-warning"
                                        onclick="mintNFT('<%= product.id %>')">
                                    <i class="bi bi-shield-check me-2"></i>Mint NFT
                                </button>
                            <% } else { %>
                                <button class="btn btn-outline-success"
                                        onclick="generateQR('<%= product.id %>')">
                                    <i class="bi bi-qr-code me-2"></i>QR Code
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (products.length === 0) { %>
            <div class="alert alert-info">
                No products found. Use the "Create New Product" button to create your first product.
            </div>
        <% } %>
    </div>

    <!-- New Product Modal -->
    <div class="modal fade" id="newProductModal" tabindex="-1" aria-labelledby="newProductModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="newProductModalLabel">Create New Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="newProductForm">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="productId" class="form-label">Product ID</label>
                                <input type="text" class="form-control" id="productId" value="prod_<%= Date.now() %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="productType" class="form-label">Product Type</label>
                                <input type="text" class="form-control" id="productType" placeholder="T-shirt, Dress, etc." required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="manufacturer" class="form-label">Manufacturer</label>
                                <input type="text" class="form-control" id="manufacturer" required>
                            </div>
                            <div class="col-md-6">
                                <label for="productDate" class="form-label">Production Date</label>
                                <input type="date" class="form-control" id="productDate" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="batchSelect" class="form-label">Cotton Batches</label>
                            <select class="form-select" id="batchSelect" multiple required>
                                <!-- Options will be loaded dynamically -->
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple batches</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="createProductBtn">Create Product</button>
                </div>
            </div>
        </div>
    </div>

    <!-- QR Code Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="qrModalLabel">Product QR Code</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div id="qrcode"></div>
                    <p class="mt-3 mb-0">Scan to verify product authenticity</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="downloadQR">Download QR Code</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Load batches for the new product form
            loadBatches();

            // Handle filters
            document.getElementById('applyFilters').addEventListener('click', function() {
                filterProducts();
            });

            // Handle create product
            document.getElementById('createProductBtn').addEventListener('click', function() {
                createProduct();
            });
        });

        // Load available batches for the new product form
        async function loadBatches() {
            try {
                const response = await fetch('/api/batches');
                const batches = await response.json();

                const batchSelect = document.getElementById('batchSelect');
                batchSelect.innerHTML = '';

                batches.forEach(batch => {
                    const option = document.createElement('option');
                    option.value = batch.id;
                    option.textContent = `${batch.id} (${batch.quantity} kg, ${batch.organic ? 'Organic' : 'Regular'})`;
                    batchSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Error loading batches:', error);
                alert('Failed to load batches. See console for details.');
            }
        }

        // Filter products based on selected criteria
        function filterProducts() {
            const typeFilter = document.getElementById('typeFilter').value;
            const manufacturerFilter = document.getElementById('manufacturerFilter').value;
            const searchFilter = document.getElementById('searchFilter').value.toLowerCase();

            const products = document.querySelectorAll('.product-item');

            products.forEach(product => {
                let showProduct = true;

                // Type filter
                if (typeFilter && product.getAttribute('data-type') !== typeFilter) {
                    showProduct = false;
                }

                // Manufacturer filter
                if (manufacturerFilter && product.getAttribute('data-manufacturer') !== manufacturerFilter) {
                    showProduct = false;
                }

                // Search filter
                if (searchFilter) {
                    const productText = product.textContent.toLowerCase();
                    if (!productText.includes(searchFilter)) {
                        showProduct = false;
                    }
                }

                // Show/hide product
                product.style.display = showProduct ? 'block' : 'none';
            });
        }

        // Create a new product
        async function createProduct() {
            try {
                const batchSelect = document.getElementById('batchSelect');
                const selectedBatches = Array.from(batchSelect.selectedOptions).map(option => option.value);

                if (selectedBatches.length === 0) {
                    alert('Please select at least one batch');
                    return;
                }

                const data = {
                    productID: document.getElementById('productId').value,
                    productType: document.getElementById('productType').value,
                    manufacturer: document.getElementById('manufacturer').value,
                    batchIDs: selectedBatches,
                    productDate: document.getElementById('productDate').value
                };

                const response = await fetch('/api/products', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Product created successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error creating product:', error);
                alert('Failed to create product. See console for details.');
            }
        }

        // Mint NFT for a product
        async function mintNFT(productId) {
            try {
                const response = await fetch('/api/mint-nft', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ productId })
                });

                const result = await response.json();

                if (response.ok) {
                    alert('NFT minting request submitted successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error minting NFT:', error);
                alert('Failed to mint NFT. See console for details.');
            }
        }

        // Generate QR code for a product
        function generateQR(productId) {
            // Clear previous QR code
            const qrContainer = document.getElementById('qrcode');
            qrContainer.innerHTML = '';

            // Generate verification URL
            const verifyUrl = window.location.origin + '/verify/' + productId;

            // Generate QR code
            QRCode.toCanvas(qrContainer, verifyUrl, {
                width: 256,
                margin: 2,
                color: {
                    dark: '#000000',
                    light: '#ffffff'
                }
            }, function(error) {
                if (error) {
                    console.error('Error generating QR code:', error);
                    alert('Failed to generate QR code');
                }
            });

            // Update modal title
            document.getElementById('qrModalLabel').textContent = 'QR Code for Product ' + productId;

            // Show modal
            const qrModal = new bootstrap.Modal(document.getElementById('qrModal'));
            qrModal.show();

            // Handle download button
            document.getElementById('downloadQR').onclick = function() {
                const canvas = qrContainer.querySelector('canvas');
                const image = canvas.toDataURL('image/png');
                const link = document.createElement('a');
                link.href = image;
                link.download = `product-${productId}-qr.png`;
                link.click();
            };
        }
    </script>
</body>
</html>