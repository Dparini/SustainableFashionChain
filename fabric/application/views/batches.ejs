<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - SustainableFashionChain</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .batch-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .batch-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }
        .card-header {
            font-weight: bold;
        }
        .filters {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }
        .status-harvested { background-color: #20c997; }
        .status-processing { background-color: #fd7e14; }
        .status-stored { background-color: #6610f2; }
        .status-tokenized { background-color: #ffc107; }
        .status-transported { background-color: #0dcaf0; }
        .detail-badge {
            font-size: 0.8rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .batch-icon {
            font-size: 2.5rem;
            margin-bottom: 10px;
            color: #198754;
        }
        .summary-box {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            text-align: center;
        }
        .summary-value {
            font-size: 2rem;
            font-weight: bold;
            margin: 10px 0;
        }
        .summary-label {
            color: #6c757d;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                SustainableFashionChain
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/analytics">Analytics</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/batches">Batches</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1><i class="bi bi-box-seam me-2"></i>Cotton Batches</h1>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newBatchModal">
                <i class="bi bi-plus-circle me-2"></i>Register New Batch
            </button>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="batch-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="summary-value"><%= batches.length %></div>
                    <div class="summary-label">Total Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="batch-icon text-primary">
                        <i class="bi bi-flower1"></i>
                    </div>
                    <div class="summary-value">
                        <%= batches.filter(b => b.organic).length %>
                    </div>
                    <div class="summary-label">Organic Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="batch-icon text-warning">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="summary-value">
                        <%= batches.filter(b => b.fairTrade).length %>
                    </div>
                    <div class="summary-label">Fair Trade Batches</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="summary-box">
                    <div class="batch-icon text-info">
                        <i class="bi bi-coin"></i>
                    </div>
                    <div class="summary-value">
                        <%= batches.filter(b => b.tokenizationId).length %>
                    </div>
                    <div class="summary-label">Tokenized Batches</div>
                </div>
            </div>
        </div>

        <div class="filters mb-4">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="statusFilter" class="form-label">Status</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="Harvested">Harvested</option>
                        <option value="Processing">Processing</option>
                        <option value="Stored">Stored</option>
                        <option value="Transported">Transported</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="certificationFilter" class="form-label">Certification</label>
                    <select class="form-select" id="certificationFilter">
                        <option value="">All Certifications</option>
                        <option value="organic">Organic</option>
                        <option value="fairTrade">Fair Trade</option>
                        <option value="tokenized">Tokenized</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="searchFilter" class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchFilter" placeholder="Search by ID, farm, location...">
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" id="applyFilters">
                        <i class="bi bi-funnel me-2"></i>Apply Filters
                    </button>
                </div>
            </div>
        </div>

        <div class="row" id="batchesContainer">
            <% batches.forEach(batch => { %>
                <div class="col-md-6 batch-item"
                     data-status="<%= batch.status %>"
                     data-organic="<%= batch.organic %>"
                     data-fairtrade="<%= batch.fairTrade %>"
                     data-tokenized="<%= batch.tokenizationId ? 'true' : 'false' %>">
                    <div class="card batch-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div>
                                <span class="status-indicator status-<%= batch.status.toLowerCase() %>"></span>
                                Batch <%= batch.id %>
                            </div>
                            <div>
                                <% if (batch.organic) { %>
                                    <span class="badge bg-success detail-badge">Organic</span>
                                <% } %>
                                <% if (batch.fairTrade) { %>
                                    <span class="badge bg-primary detail-badge">Fair Trade</span>
                                <% } %>
                                <% if (batch.tokenizationId) { %>
                                    <span class="badge bg-warning text-dark detail-badge">Tokenized</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Farm:</strong> <%= batch.farmId %></p>
                                    <p><strong>Quantity:</strong> <%= batch.quantity %> kg</p>
                                    <p><strong>Harvest Date:</strong> <%= new Date(batch.harvestDate).toLocaleDateString() %></p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Status:</strong> <%= batch.status %></p>
                                    <p><strong>Current Custody:</strong> <%= batch.currentCustody %></p>
                                    <p><strong>Location:</strong> <%= batch.location %></p>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a href="/batches/<%= batch.id %>" class="btn btn-outline-success">
                                <i class="bi bi-info-circle me-2"></i>View Details
                            </a>

                            <% if (batch.status === 'Stored' && !batch.tokenizationId) { %>
                                <button class="btn btn-outline-warning float-end"
                                        data-bs-toggle="modal"
                                        data-bs-target="#tokenizeModal"
                                        data-batch-id="<%= batch.id %>"
                                        data-batch-quantity="<%= batch.quantity %>">
                                    <i class="bi bi-coin me-2"></i>Tokenize
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (batches.length === 0) { %>
            <div class="alert alert-info">
                No cotton batches found. Use the "Register New Batch" button to create your first batch.
            </div>
        <% } %>
    </div>

    <!-- New Batch Modal -->
    <div class="modal fade" id="newBatchModal" tabindex="-1" aria-labelledby="newBatchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="newBatchModalLabel">Register New Cotton Batch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="newBatchForm">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="batchId" class="form-label">Batch ID</label>
                                <input type="text" class="form-control" id="batchId" value="batch_<%= Date.now() %>" required>
                            </div>
                            <div class="col-md-6">
                                <label for="farmId" class="form-label">Farm ID</label>
                                <input type="text" class="form-control" id="farmId" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="quantity" class="form-label">Quantity (kg)</label>
                                <input type="number" class="form-control" id="quantity" required>
                            </div>
                            <div class="col-md-4">
                                <label for="harvestDate" class="form-label">Harvest Date</label>
                                <input type="date" class="form-control" id="harvestDate" required>
                            </div>
                            <div class="col-md-4">
                                <label for="location" class="form-label">Location</label>
                                <input type="text" class="form-control" id="location" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="organic">
                                    <label class="form-check-label" for="organic">
                                        Organic
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="fairTrade">
                                    <label class="form-check-label" for="fairTrade">
                                        Fair Trade
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="createBatchBtn">Register Batch</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tokenize Modal -->
    <div class="modal fade" id="tokenizeModal" tabindex="-1" aria-labelledby="tokenizeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tokenizeModalLabel">Tokenize Cotton Batch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="tokenizeForm">
                        <div class="mb-3">
                            <label for="modalBatchId" class="form-label">Batch ID</label>
                            <input type="text" class="form-control" id="modalBatchId" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="requestId" class="form-label">Request ID</label>
                            <input type="text" class="form-control" id="requestId" value="req_<%= Date.now() %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="tokenQuantity" class="form-label">Quantity to Tokenize (kg)</label>
                            <input type="number" class="form-control" id="tokenQuantity" required>
                            <small class="text-muted">Maximum available: <span id="maxQuantity"></span> kg</small>
                        </div>
                        <div class="mb-3">
                            <label for="warehouseId" class="form-label">Warehouse ID</label>
                            <input type="text" class="form-control" id="warehouseId" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning" id="tokenizeBtn">Request Tokenization</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0">SustainableFashionChain - A Blockchain-Based Platform for Ethical Fashion Traceability</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle filters
            document.getElementById('applyFilters').addEventListener('click', function() {
                filterBatches();
            });

            // Initialize tokenize modal
            const tokenizeModal = document.getElementById('tokenizeModal');
            tokenizeModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const batchId = button.getAttribute('data-batch-id');
                const quantity = button.getAttribute('data-batch-quantity');

                document.getElementById('modalBatchId').value = batchId;
                document.getElementById('tokenQuantity').value = quantity;
                document.getElementById('tokenQuantity').max = quantity;
                document.getElementById('maxQuantity').textContent = quantity;
            });

            // Handle create batch
            document.getElementById('createBatchBtn').addEventListener('click', function() {
                createBatch();
            });

            // Handle tokenize batch
            document.getElementById('tokenizeBtn').addEventListener('click', function() {
                tokenizeBatch();
            });
        });

        // Filter batches based on selected criteria
        function filterBatches() {
            const statusFilter = document.getElementById('statusFilter').value;
            const certificationFilter = document.getElementById('certificationFilter').value;
            const searchFilter = document.getElementById('searchFilter').value.toLowerCase();

            const batches = document.querySelectorAll('.batch-item');

            batches.forEach(batch => {
                let showBatch = true;

                // Status filter
                if (statusFilter && batch.getAttribute('data-status') !== statusFilter) {
                    showBatch = false;
                }

                // Certification filter
                if (certificationFilter) {
                    if (certificationFilter === 'organic' && batch.getAttribute('data-organic') !== 'true') {
                        showBatch = false;
                    } else if (certificationFilter === 'fairTrade' && batch.getAttribute('data-fairtrade') !== 'true') {
                        showBatch = false;
                    } else if (certificationFilter === 'tokenized' && batch.getAttribute('data-tokenized') !== 'true') {
                        showBatch = false;
                    }
                }

                // Search filter
                if (searchFilter) {
                    const batchText = batch.textContent.toLowerCase();
                    if (!batchText.includes(searchFilter)) {
                        showBatch = false;
                    }
                }

                // Show/hide batch
                batch.style.display = showBatch ? 'block' : 'none';
            });
        }

        // Create a new batch
        async function createBatch() {
            try {
                const data = {
                    id: document.getElementById('batchId').value,
                    farmID: document.getElementById('farmId').value,
                    quantity: parseFloat(document.getElementById('quantity').value),
                    organic: document.getElementById('organic').checked,
                    fairTrade: document.getElementById('fairTrade').checked,
                    harvestDate: document.getElementById('harvestDate').value,
                    location: document.getElementById('location').value
                };

                const response = await fetch('/api/batches', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Batch created successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error creating batch:', error);
                alert('Failed to create batch. See console for details.');
            }
        }

        // Tokenize a batch
        async function tokenizeBatch() {
            try {
                const data = {
                    requestID: document.getElementById('requestId').value,
                    batchID: document.getElementById('modalBatchId').value,
                    quantity: parseFloat(document.getElementById('tokenQuantity').value),
                    warehouseID: document.getElementById('warehouseId').value
                };

                const response = await fetch('/api/tokenize', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert('Tokenization requested successfully!');
                    window.location.reload();
                } else {
                    alert(`Error: ${result.error}`);
                }
            } catch (error) {
                console.error('Error requesting tokenization:', error);
                alert('Failed to request tokenization. See console for details.');
            }
        }
    </script>
</body>
</html>