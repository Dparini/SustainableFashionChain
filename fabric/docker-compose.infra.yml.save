version: '3.8'

services:
  # Redis Cluster
  redis-1:
    image: redis:7.0
    platform: linux/amd64
    command: redis-server --port 6379
    ports:
      - "6379:6379"
    volumes:
      - redis-1-data:/data
    networks:
      - sustainable-fashion-network

  redis-2:
    image: redis:7.0
    platform: linux/amd64
    command: redis-server --port 6380
    ports:
      - "6380:6380"
    volumes:
      - redis-2-data:/data
    networks:
      - sustainable-fashion-network

  redis-3:
    image: redis:7.0
    platform: linux/amd64
    command: redis-server --port 6381
    ports:
      - "6381:6381"
    volumes:
      - redis-3-data:/data
    networks:
      - sustainable-fashion-network

  # RabbitMQ
  rabbitmq:
    image: rabbitmq:3.11-management
    platform: linux/amd64
    ports:
      - "5672:5672"   # AMQP protocol
      - "15672:15672" # Management UI
    environment:
      - RABBITMQ_DEFAULT_USER=admin
      - RABBITMQ_DEFAULT_PASS=sustainablefashion
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    networks:
      - sustainable-fashion-network

  # MongoDB Sharded Cluster
  # Config Servers
  mongo-config-1:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --configsvr --replSet configReplSet --port 27017
    volumes:
      - mongo-config-1:/data/db
    networks:
      - sustainable-fashion-network

  mongo-config-2:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --configsvr --replSet configReplSet --port 27017
    volumes:
      - mongo-config-2:/data/db
    networks:
      - sustainable-fashion-network

  mongo-config-3:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --configsvr --replSet configReplSet --port 27017
    volumes:
      - mongo-config-3:/data/db
    networks:
      - sustainable-fashion-network

  # Shard 1 Replica Set
  mongo-shard1-1:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard1 --port 27017
    volumes:
      - mongo-shard1-1:/data/db
    networks:
      - sustainable-fashion-network

  mongo-shard1-2:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard1 --port 27017
    volumes:
      - mongo-shard1-2:/data/db
    networks:
      - sustainable-fashion-network

  mongo-shard1-3:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard1 --port 27017
    volumes:
      - mongo-shard1-3:/data/db
    networks:
      - sustainable-fashion-network

  # Shard 2 Replica Set
  mongo-shard2-1:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard2 --port 27017
    volumes:
      - mongo-shard2-1:/data/db
    networks:
      - sustainable-fashion-network

  mongo-shard2-2:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard2 --port 27017
    volumes:
      - mongo-shard2-2:/data/db
    networks:
      - sustainable-fashion-network

  mongo-shard2-3:
    image: mongo:6.0
    platform: linux/amd64
    command: mongod --shardsvr --replSet shard2 --port 27017
    volumes:
      - mongo-shard2-3:/data/db
    networks:
      - sustainable-fashion-network

  # Mongos Routers
  mongos1:
    image: mongo:6.0
    platform: linux/amd64
    command: mongos --configdb configReplSet/mongo-config-1:27017,mongo-config-2:27017,mongo-config-3:27017 --bind_ip_all
    ports:
      - "27017:27017"
    depends_on:
      - mongo-config-1
      - mongo-config-2
      - mongo-config-3
      - mongo-shard1-1
      - mongo-shard2-1
    networks:
      - sustainable-fashion-network

  mongos2:
    image: mongo:6.0
    platform: linux/amd64
    command: mongos --configdb configReplSet/mongo-config-1:27017,mongo-config-2:27017,mongo-config-3:27017 --bind_ip_all
    ports:
      - "27018:27017"
    depends_on:
      - mongo-config-1
      - mongo-config-2
      - mongo-config-3
      - mongo-shard1-1
      - mongo-shard2-1
    networks:
      - sustainable-fashion-network

  # MongoDB Setup
  mongo-setup:
    image: mongo:6.0
    platform: linux/amd64
    volumes:
      - ./scripts/mongo-setup.sh:/scripts/mongo-setup.sh
    entrypoint: ["bash", "/scripts/mongo-setup.sh"]
    depends_on:
      - mongos1
      - mongos2
    networks:
      - sustainable-fashion-network

volumes:
  redis-1-data:
  redis-2-data:
  redis-3-data:
  rabbitmq-data:
  mongo-config-1:
  mongo-config-2:
  mongo-config-3:
  mongo-shard1-1:
  mongo-shard1-2:
  mongo-shard1-3:
  mongo-shard2-1:
  mongo-shard2-2:
  mongo-shard2-3:

networks:
  sustainable-fashion-network:
    external: true
